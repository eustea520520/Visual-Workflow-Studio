            VALUE "OriginalFilename", "visual-workflow-studio.exe"
            VALUE "ProductName",      "Visual Workflow Studio"
            VALUE "ProductVersion",   "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
