            VALUE "CompanyName",      "Visual Workflow Studio"
            VALUE "FileDescription",  "Visual Workflow Studio - Visual DAG Workflow Builder"
            VALUE "FileVersion",      "0.2.0"
            VALUE "InternalName",     "visual-workflow-studio"
