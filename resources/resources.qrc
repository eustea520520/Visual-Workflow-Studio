<RCC>
  <qresource prefix="/styles">
    <file alias="light.qss">styles/light.qss</file>
    <file alias="dark.qss">styles/dark.qss</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="workspace-new.svg">icons/workspace-new.svg</file>
    <file alias="workspace-open.svg">icons/workspace-open.svg</file>
    <file alias="python.svg">icons/python.svg</file>
    <file alias="workflow-new.svg">icons/workflow-new.svg</file>
    <file alias="save.svg">icons/save.svg</file>
    <file alias="template-save.svg">icons/template-save.svg</file>
    <file alias="link.svg">icons/link.svg</file>
    <file alias="import.svg">icons/import.svg</file>
    <file alias="run.svg">icons/run.svg</file>
    <file alias="stop.svg">icons/stop.svg</file>
    <file alias="theme.svg">icons/theme.svg</file>
  </qresource>
</RCC>
